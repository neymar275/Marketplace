{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmitOnError": false,
    "checkJs": false
  },
  // 🚀 ADD OR SET THESE TWO TO FALSE TO BYPASS IMPLICIT TYPE CRASHES
  "include": [
    "src/**/*"
  ]
}